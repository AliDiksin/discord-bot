# Never commit a real .env. Load it into a trusted shell; never pass secrets as arguments.
SFSTATS_DISCORD_ENABLED=true
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_QUEUE_CHANNEL_ID=
DISCORD_BOT_TOKEN=
# Shared with the backend that receives reaction events. At least 32 bytes.
SFSTATS_INTERNAL_SECRET=

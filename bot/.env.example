# Bub (FrameBub) with the SF Stats link. Copy to bot/.env and fill it in; never commit it.
# Without the SFSTATS_* lines the bot runs as plain Bub.

DISCORD_TOKEN=

# SF Stats commands, buttons and forms (/cfn, /profile, /link, leaderboards) are forwarded here.
SFSTATS_BRIDGE_URL=https://sfstats.app/internal/discord/interactions
# Shared with sfstats.app. Sent privately by the SF Stats maintainer; never post it in a channel.
SFSTATS_INTERNAL_SECRET=

# "@SF Stats my rank" and other plain-language requests go to sfstats.app, whose Decisions check
# picks SF Stats or Bub. Bub answers anything SF Stats doesn't claim, and everything when the site is slow.
SFSTATS_NATURAL_LANGUAGE=true
SFSTATS_ROUTE_BUB_MENTIONS=true

# false: SF Stats commands are registered only in the test servers (SFSTATS_BRIDGE_GUILD_IDS,
# default BUENAVISTA and the SF Stats server). true: everywhere. Leave false until testing is done.
SFSTATS_COMMANDS_GLOBAL=false
# SFSTATS_BRIDGE_GUILD_IDS=1345474576439836802,1539390905503715528

# The Streetfighterdle launcher command needs Activities enabled on the application.
# Set false on an app without Activities.
# STREETFIGHTERDLE_ACTIVITY_ENTRY=false

# Decisions API (OpenRouter), asked in layers. Without a key the bot behaves as before.
#   1. Route: frame data (Bub answers here) or SF Stats data (forwarded to sfstats.app as already routed).
#      Clear wording ("ken 5mp", "my rank") is routed without a request.
#   2. Frame data Bub can't read: game, character and move picked from Bub's own tables, then answered by Bub.
# Use a key with a spending limit; never share the SF Stats web app's own key.
# DECISIONS_API_KEY=
# DECISIONS_MODEL=openai/gpt-6-luna-decisions
# DECISIONS_TIMEOUT_SECONDS=1.8
# How sure an answer must be (also the model's top choice, never "none"); default 0.4.
# DECISIONS_CONFIDENCE=0.4
